{
    "name": "moinframe/kirby-cookie-consent",
    "description": "Cookie Consent is a customizable, accessible privacy consent plugin for Kirby CMS.",
    "homepage": "https://github.com/moinframe/kirby-cookie-consent",
    "license": "MIT",
    "type": "kirby-plugin",
    "version": "0.2.0",
    "keywords": [
        "kirby",
        "kirby-plugin",
        "cookie",
        "consent",
        "gdpr",
        "privacy"
    ],
    "authors": [
        {
            "name": "Justus Kraft",
            "email": "justus@moinfra.me"
        }
    ],
    "require": {
        "php": ">=8.1",
        "getkirby/cms": "^4.0 || ^5.0",
        "getkirby/composer-installer": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Moinframe\\CookieConsent\\": "src/"
        }
    },
    "support": {
        "source": "https://github.com/moinframe/kirby-cookie-consent",
        "issues": "https://github.com/moinframe/kirby-cookie-consent/issues"
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "fix": "php-cs-fixer fix --config .php-cs-fixer.dist.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "extra": {
        "installer-name": "cookie-consent"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    }
}